+/* ---------- 3D-превʼю ---------- */
+.open3d{display:flex;align-items:center;justify-content:center;gap:8px;margin:12px auto 0;
+  padding:10px 18px;border-radius:999px;border:1px solid var(--line);background:#fff;
+  font:500 14.5px/1 Onest,sans-serif;color:var(--accent);cursor:pointer;
+  transition:border-color .15s,background .15s}
+.open3d:hover{border-color:var(--accent);background:var(--surface)}
+.open3d svg{flex:none}
+.v3d{padding:0;border:none;border-radius:18px;background:var(--surface);color:var(--ink);
+  width:min(560px,100vw - 24px);height:min(860px,100dvh - 24px);max-width:none;max-height:none;
+  box-shadow:0 20px 60px rgba(26,18,22,.28);overflow:hidden}
+.v3d[open]{display:flex;flex-direction:column}
+.v3d::backdrop{background:rgba(26,18,22,.45);backdrop-filter:blur(2px)}
+.v3d-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 14px 0 20px}
+.v3d-head h2{margin:0;font-size:19px}
+.v3d-head small{display:block;font:400 13px/1.3 Onest,sans-serif;color:var(--dim);margin-top:2px}
+.v3d-x{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;
+  font-size:22px;line-height:1;color:var(--ink);cursor:pointer;display:grid;place-content:center;padding:0}
+.v3d-x:hover{border-color:#C9BCC4}
+.v3d-stage{position:relative;flex:1;min-height:0}
+.v3d-stage .v3d-load{position:absolute;inset:0;display:grid;place-content:center;
+  font-size:14px;color:var(--dim)}
+.v3d-foot{padding:0 16px 16px}
+.v3d-foot .sides{margin-top:0}
+.v3d-foot .note{text-align:center;margin:9px 0 0}
+@media (max-width:600px){ .v3d{width:100vw;height:100dvh;border-radius:0} }
+
 @media (max-width:430px){ .pair{grid-template-columns:1fr} }
 @media (prefers-reduced-motion:reduce){ *{animation:none!important;transition:none!important} }
 </style>
