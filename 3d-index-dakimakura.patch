+/* ---------- 3D-превʼю ----------
+   three.js і сама модель вантажаться лише після першого відкриття */
+let v3d = null;
+const dlg = $('v3d');
+const markSide = id => [...$('v3dSides').children]
+  .forEach(b => b.setAttribute('aria-selected', b.dataset.side === id));
+
+$('open3d').onclick = async () => {
+  if (!ready) return fail('Мокапи ще вантажаться, зачекай секунду.');
+  $('v3dSize').textContent = `${size.label} см`;
+  dlg.showModal();
+  track('open_3d', { size: size.v, has_photo: !!hasAny() });
+  try {
+    if (!v3d) {
+      const { Dakimakura3D } = await import('./dakimakura-3d.js?v=' + (root.v || ''));
+      v3d = new Dakimakura3D({ host: $('v3dStage'), sides: { A, B }, size, mobile: M.isMobile() });
+      v3d.onTurn = markSide;
+      await v3d.init();
+      $('v3dLoad').remove();
+    }
+    v3d.setSize(size);
+    v3d.refresh();
+    // відкриваємо ту сторону, з якою людина зараз працює
+    v3d.show(cur);
+    v3d.start();
+  } catch (err) {
+    const l = $('v3dLoad') || $('v3dStage').appendChild(Object.assign(document.createElement('p'), { className: 'v3d-load', id: 'v3dLoad' }));
+    l.textContent = 'Не вдалося показати 3D на цьому пристрої. Плоскі макети вище показують те саме.';
+    console.error(err);
+  }
+};
+[...$('v3dSides').children].forEach(b => { b.onclick = () => { markSide(b.dataset.side); v3d?.show(b.dataset.side); }; });
+$('v3dClose').onclick = () => dlg.close();
+dlg.addEventListener('click', e => { if (e.target === dlg) dlg.close(); });   // клік повз вікно
+dlg.addEventListener('close', () => v3d?.stop());
+
 /* ---------- підгонка ---------- */
 const STEP = 0.035;
 const targets = () => ($('both').checked ? [A, B].filter(s => s.filled) : [side()].filter(s => s.filled));
